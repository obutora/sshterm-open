{
  "about": "Documents of the SSH Term theme format v1 and what the app makes of them. Replayed by the app's tests and, for the JSON Schema, by sshterm-open.",
  "fields": {
    "file": "Path from this directory.",
    "valid": "Whether the app reads it.",
    "themes": "valid: how many themes it holds.",
    "reason": "invalid: the problem's code (tooLarge, notJson, notThemeFile, newerVersion, badVersion, themeCount, unknownField, badSchema, missingField, wrongType, badId, duplicateId, badText, badLicense, badColor, missingColor).",
    "theme": "invalid: 0-based index in themes of the theme at fault; null for the document itself.",
    "field": "invalid: the field at fault, a dotted path in the theme (name, basedOn.author, colors.red) or in the document (formatVersion, themes); null for the whole.",
    "textProblem": "badText: empty, tooLong or forbiddenCharacter (names and authors are trimmed, then 1-40 code points without control or direction characters).",
    "jsonSchema": "\"same\": a JSON Schema validator (plus JSON.parse) reaches the same verdict. \"not-expressible\": it cannot (size in bytes, trimming, IDs unique across themes); a checker needs code for these on top of the schema.",
    "note": "What the case is about."
  },
  "cases": [
